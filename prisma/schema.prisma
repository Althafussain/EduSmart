generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  relationMode = "prisma"
  url          = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum EducationLevel {
  GRADE
  O_LEVEL
  A_LEVEL
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum EvaluationStatus {
  PENDING
  AI_ASSISTED
  REVIEWED
}

model User {
  id                 String                 @id @default(auto()) @map("_id") @db.ObjectId
  email              String                 @unique
  passwordHash       String?
  fullName           String
  mobileNumber       String?
  role               Role                   @default(STUDENT)
  educationLevel     String?
  stream             String?
  subjects           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  profile            StudentProfile?
  attempts           ExamAttempt[]
  quizAttemptHistory QuizAttemptHistory[]
  learning           LearningHistory[]
  analytics          PerformanceAnalytics[]
}

model StudentProfile {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  userId            String           @unique @db.ObjectId
  district          String
  province          String
  schoolName        String
  educationLevel    EducationLevel
  grade             Int?
  stream            String?
  preferredLanguage String           @default("English")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects          StudentSubject[]
}

model Subject {
  id        String                 @id @default(auto()) @map("_id") @db.ObjectId
  name      String                 @unique
  students  StudentSubject[]
  exams     Exam[]
  resources LearningResource[]
  analytics PerformanceAnalytics[]
}

model StudentSubject {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  studentProfileId String         @db.ObjectId
  subjectId        String         @db.ObjectId
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, subjectId])
}

model Exam {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  educationLevel     EducationLevel
  grade              Int?
  stream             String?
  durationMins       Int
  totalMarks         Int
  startsAt           DateTime
  endsAt             DateTime
  isQuiz             Boolean              @default(false)
  published          Boolean              @default(false)
  subjectId          String               @db.ObjectId
  subject            Subject              @relation(fields: [subjectId], references: [id])
  questions          Question[]
  attempts           ExamAttempt[]
  quizAttemptHistory QuizAttemptHistory[]
}

model Question {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  examId         String          @db.ObjectId
  type           QuestionType
  prompt         String
  imageUrl       String?
  optionImages   String[]        @default([])
  marks          Int
  options        Json?
  correctAnswer  String?
  expectedAnswer String?
  markingRubric  Json?
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        StudentAnswer[]
}

model ExamAttempt {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  examId      String          @db.ObjectId
  userId      String          @db.ObjectId
  status      AttemptStatus   @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  expiresAt   DateTime
  exam        Exam            @relation(fields: [examId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  answers     StudentAnswer[]
  result      Result?

  @@unique([examId, userId])
}

model QuizAttemptHistory {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  examId        String        @db.ObjectId
  userId        String        @db.ObjectId
  status        AttemptStatus
  startedAt     DateTime
  submittedAt   DateTime?
  expiresAt     DateTime
  obtainedMarks Float?
  totalMarks    Float?
  percentage    Float?
  passed        Boolean?
  archivedAt    DateTime      @default(now())
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId, userId])
}

model StudentAnswer {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  attemptId        String           @db.ObjectId
  questionId       String           @db.ObjectId
  answer           String?
  awardedMarks     Float?
  feedback         String?
  evaluationStatus EvaluationStatus @default(PENDING)
  modelVersion     String?
  attempt          ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Result {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  attemptId         String      @unique @db.ObjectId
  obtainedMarks     Float
  totalMarks        Float?
  percentage        Float
  passed            Boolean
  aiFeedback        String?
  improvementAreas  Json?
  recommendedTopics Json?
  attempt           ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model LearningResource {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  externalId  String            @unique
  title       String
  url         String
  thumbnail   String?
  description String?
  subjectId   String            @db.ObjectId
  difficulty  String?
  subject     Subject           @relation(fields: [subjectId], references: [id])
  history     LearningHistory[]
}

model Book {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  author      String
  subject     String
  level       String
  price       Int
  imageUrl    String?
  coverColor  String   @default("mint")
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subject     String
  level       String
  duration    String
  videoUrl    String
  thumbnail   String?
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WrittenPaper {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  subject        String
  educationLevel EducationLevel
  grade          Int?
  stream         String?
  fileName       String
  durationMins   Int?           @default(60)
  mimeType       String
  document       Bytes
  published      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model WrittenPaperAttempt {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  paperId     String    @db.ObjectId
  userId      String    @db.ObjectId
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  fileName    String?
  mimeType    String?
  document    Bytes?

  @@unique([paperId, userId])
}

model LearningHistory {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  resourceId   String           @db.ObjectId
  watchedAt    DateTime         @default(now())
  progressSecs Int              @default(0)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     LearningResource @relation(fields: [resourceId], references: [id])
}

model PerformanceAnalytics {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  subjectId    String   @db.ObjectId
  averageMarks Float
  strongAreas  Json?
  weakAreas    Json?
  trend        Json?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject  @relation(fields: [subjectId], references: [id])

  @@unique([userId, subjectId])
}
