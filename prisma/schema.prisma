generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { STUDENT ADMIN TEACHER }
enum EducationLevel { GRADE O_LEVEL A_LEVEL }
enum QuestionType { MCQ TRUE_FALSE SHORT_ANSWER ESSAY }
enum AttemptStatus { IN_PROGRESS SUBMITTED EXPIRED }
enum EvaluationStatus { PENDING AI_ASSISTED REVIEWED }

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  mobileNumber  String?
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       StudentProfile?
  attempts      ExamAttempt[]
  learning      LearningHistory[]
  analytics     PerformanceAnalytics[]
}

model StudentProfile {
  id                String         @id @default(cuid())
  userId            String         @unique
  district          String
  province          String
  schoolName        String
  educationLevel    EducationLevel
  grade             Int?
  stream            String?
  preferredLanguage String         @default("English")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects          StudentSubject[]
}

model Subject {
  id         String             @id @default(cuid())
  name       String             @unique
  students   StudentSubject[]
  exams      Exam[]
  resources  LearningResource[]
  analytics  PerformanceAnalytics[]
}

model StudentSubject {
  studentProfileId String
  subjectId        String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@id([studentProfileId, subjectId])
}

model Exam {
  id             String         @id @default(cuid())
  title          String
  description    String?
  educationLevel EducationLevel
  grade          Int?
  stream         String?
  durationMins   Int
  totalMarks     Int
  startsAt       DateTime
  endsAt         DateTime
  published      Boolean        @default(false)
  subjectId      String
  subject        Subject        @relation(fields: [subjectId], references: [id])
  questions      Question[]
  attempts       ExamAttempt[]
}

model Question {
  id                String           @id @default(cuid())
  examId            String
  type              QuestionType
  prompt            String
  marks             Int
  options           Json?
  correctAnswer     String?
  expectedAnswer    String?
  markingRubric     Json?
  exam              Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers           StudentAnswer[]
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  userId      String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  expiresAt   DateTime
  exam        Exam          @relation(fields: [examId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  answers     StudentAnswer[]
  result      Result?
  @@unique([examId, userId])
}

model StudentAnswer {
  id               String           @id @default(cuid())
  attemptId        String
  questionId       String
  answer           String?
  awardedMarks     Float?
  feedback         String?
  evaluationStatus EvaluationStatus @default(PENDING)
  modelVersion     String?
  attempt          ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  @@unique([attemptId, questionId])
}

model Result {
  id                String      @id @default(cuid())
  attemptId         String      @unique
  obtainedMarks     Float
  percentage        Float
  passed            Boolean
  aiFeedback        String?
  improvementAreas  Json?
  recommendedTopics Json?
  attempt           ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model LearningResource {
  id          String   @id @default(cuid())
  externalId  String   @unique
  title       String
  url         String
  thumbnail   String?
  description String?
  subjectId   String
  difficulty  String?
  subject     Subject  @relation(fields: [subjectId], references: [id])
  history     LearningHistory[]
}

model LearningHistory {
  id           String           @id @default(cuid())
  userId       String
  resourceId   String
  watchedAt    DateTime         @default(now())
  progressSecs Int              @default(0)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     LearningResource @relation(fields: [resourceId], references: [id])
}

model PerformanceAnalytics {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String
  averageMarks Float
  strongAreas  Json?
  weakAreas    Json?
  trend        Json?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject  @relation(fields: [subjectId], references: [id])
  @@unique([userId, subjectId])
}
